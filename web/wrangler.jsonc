{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ae-web",
  "main": "composition/worker.tsx",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/workspace",
      "/workspace/*",
      "/guest",
      "/guest/*",
      "/auth/*",
      "/api/*"
    ]
  },
  "workers_dev": false,
  "preview_urls": false
}

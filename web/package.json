{
  "name": "@ae/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "check": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "astro": "7.3.1",
    "@astrojs/cloudflare": "14.3.0",
    "@astrojs/react": "6.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "wrangler": "4.129.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "sourceRevision": {
      "type": "string"
    },
    "publishedRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "published",
        "withdrawn"
      ]
    }
  },
  "required": [
    "id",
    "sourceRevision",
    "publishedRevision",
    "state"
  ]
}

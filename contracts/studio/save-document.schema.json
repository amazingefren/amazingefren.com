{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string"
    },
    "markdown": {
      "type": "string"
    },
    "privateNotes": {
      "type": "string"
    },
    "kind": {
      "enum": ["note", "article", "publication"]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "expectedRevision": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "title",
    "markdown",
    "privateNotes",
    "kind",
    "id",
    "expectedRevision"
  ]
}

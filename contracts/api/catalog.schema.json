{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "catalogRevision": {
      "type": "string"
    },
    "sourceRevision": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "implementationVisibility": {
      "enum": ["public", "private"]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": ["declared", "prototype", "implemented"]
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contracts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "access", "status", "bindings", "verification"],
        "properties": {
          "id": { "type": "string" },
          "access": { "const": "public" },
          "status": { "enum": ["declared", "implemented"] },
          "bindings": { "type": "array" },
          "verification": { "type": "array" }
        }
      }
    }
  },
  "required": [
    "id",
    "sourceRevision",
    "name",
    "purpose",
    "implementationVisibility",
    "capabilities"
  ]
}

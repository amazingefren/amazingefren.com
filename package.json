{
  "name": "ae",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "design:sync": "node design/adapters/css/sync.ts",
    "dev": "npm run dev --workspace @ae/web",
    "build": "npm run build --workspace @ae/web",
    "preview": "npm run preview --workspace @ae/web",
    "check": "node scripts/check-manifests.mjs && npm run check --workspace @ae/web",
    "test": "node --test scripts/check-manifests.test.mjs manifests/risks/check.test.mjs 'dashboard/tests/**/*.test.ts' 'design/tests/*.test.ts' 'workspace/tests/**/*.test.ts' 'web/tests/landing/*.test.ts' 'work/tests/*.test.ts' 'auth/tests/*.test.ts' 'web/tests/access/*.test.ts' 'cloudflare/deployment/*.test.ts' 'system-explorer/tests/*.test.ts' 'publishing/tests/**/*.test.ts' 'manifests/commits/*.test.mjs' 'mcp/tests/*.test.ts' 'web/tests/reading/*.test.ts' 'evaluation/tests/*.test.ts' 'api/tests/*.test.ts' 'evidence/tests/*.test.ts'",
    "launch:check": "node cloudflare/check-launch.ts",
    "test:launch": "npm run build && node web/tests/runtime/launch.mjs",
    "build:deploy": "node cloudflare/deployment/index.ts build",
    "migrate": "node cloudflare/deployment/index.ts migrate",
    "deploy": "node cloudflare/deployment/index.ts deploy",
    "deploy:dry-run": "node cloudflare/deployment/index.ts dry-run",
    "format": "node scripts/format/index.mjs",
    "format:check": "node scripts/format/index.mjs --check",
    "hooks": "node scripts/format/setup.mjs",
    "test:portable": "npm run build && node web/tests/runtime/portable.mjs",
    "commit:check": "node manifests/commits/cli.mjs",
    "systems": "node system-explorer/adapters/cli/main.ts",
    "publications": "node publishing/adapters/cli/main.ts"
  },
  "engines": {
    "node": ">=26.3.1"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6"
  }
}
